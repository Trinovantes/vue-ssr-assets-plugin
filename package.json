{
    "name": "vue-ssr-assets-plugin",
    "version": "0.4.11",
    "description": "Webpack 5 plugin to generate manifest of critical assets for Vue 3 SSR applications",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "README.md",
        "dist/*",
        "src/*"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Trinovantes/vue-ssr-assets-plugin"
    },
    "author": {
        "name": "Stephen",
        "email": "hello@stephenli.ca",
        "url": "https://www.stephenli.ca"
    },
    "license": "MIT",
    "private": false,
    "scripts": {
        "prepublishOnly": "pnpm clean && pnpm build",
        "clean": "rm -rf ./dist",
        "lint": "vue-tsc && eslint",
        "test": "vitest",
        "build": "tsc -p tsconfig.prod.json",
        "exDev": "  NODE_ENV=development webpack --watch --config example/webpack.config.ts",
        "exBuild": "NODE_ENV=production  webpack         --config example/webpack.config.ts",
        "exWatch": "NODE_ENV=development nodemon -r source-map-support/register dist/example/www.js --watch dist/example",
        "exStart": "NODE_ENV=production  node    -r source-map-support/register dist/example/www.js"
    },
    "dependencies": {
        "@sinclair/typebox": "^0.34.52"
    },
    "peerDependencies": {
        "vue": "^3",
        "vue-loader": "^17",
        "webpack": "^5"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/express": "^5.0.6",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.4",
        "@types/webpack": "^5.28.5",
        "@vue/server-renderer": "^3.5.43",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.5",
        "esbuild-loader": "^4.5.0",
        "eslint": "^10.12.0",
        "eslint-plugin-n": "^18.4.1",
        "eslint-plugin-vue": "^10.11.1",
        "express": "^5.2.1",
        "globals": "^17.13.0",
        "katex": "^0.19.0",
        "mini-css-extract-plugin": "^2.10.2",
        "null-loader": "^4.0.1",
        "sass": "^1.105.1",
        "sass-loader": "^17.0.1",
        "source-map-support": "^0.5.21",
        "ts-node": "^10.9.2",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.71.1",
        "vitest": "^5.0.3",
        "vue": "^3.5.43",
        "vue-eslint-parser": "^10.4.1",
        "vue-loader": "^17.4.2",
        "vue-router": "^5.4.0",
        "vue-tsc": "^3.3.12",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3",
        "webpack-merge": "^6.0.1"
    }
}
